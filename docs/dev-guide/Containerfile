# Stage 1: render AsciiDoc -> HTML
FROM docker.io/asciidoctor/docker-asciidoctor:latest AS build
WORKDIR /documents
COPY . .
RUN asciidoctor --failure-level WARN -D /out index.adoc

# Stage 2: serve it with a non-root nginx on port 8088
# (8088, not the image default 8080, so it never clashes with Spring Boot's 8080)
FROM docker.io/nginxinc/nginx-unprivileged:stable-alpine
USER root
RUN sed -i 's/8080/8088/g' /etc/nginx/conf.d/default.conf \
 && grep -q 'listen.*8088' /etc/nginx/conf.d/default.conf
USER 101
COPY --from=build /out/ /usr/share/nginx/html/
EXPOSE 8088
